{
  "$schema": "https://mintlify.com/docs.json",
  "name": "BoutiqueDB",
  "description": "The local-first database for Swift apps — reactive queries, CloudKit synchronization, and Turso-powered capabilities in a native Swift package.",
  "theme": "aspen",
  "colors": {
    "primary": "#F25F3A",
    "light": "#FF9B7A",
    "dark": "#C9432B"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F7F6F2",
      "dark": "#07101E"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "href": "/getting-started/quick-start"
      },
      {
        "tab": "Architecture",
        "href": "/advanced/boutiquedb-architecture"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/tuliopc23/BoutiqueDB-Swift"
      },
      {
        "label": "Swift Package Index",
        "href": "https://swiftpackageindex.com/tuliopc23/BoutiqueDB-Swift"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/getting-started/quick-start"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/tuliopc23/BoutiqueDB-Swift"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Quick Start",
            "href": "/getting-started/quick-start"
          },
          {
            "label": "Core Concepts",
            "href": "/core-concepts"
          },
          {
            "label": "SwiftUI Integration",
            "href": "/swiftui-integration"
          },
          {
            "label": "Turso Features",
            "href": "/turso-features-in-apple-apps"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/tuliopc23/BoutiqueDB-Swift"
          },
          {
            "label": "Swift Package Index",
            "href": "https://swiftpackageindex.com/tuliopc23/BoutiqueDB-Swift"
          },
          {
            "label": "Contributors",
            "href": "/contributors/build-engine"
          }
        ]
      },
      {
        "header": "Contribute",
        "items": [
          {
            "label": "Build Engine",
            "href": "/contributors/build-engine"
          },
          {
            "label": "Multi-Arch Packaging",
            "href": "/contributors/multi-arch-packaging"
          },
          {
            "label": "Testing",
            "href": "/contributors/testing"
          },
          {
            "label": "Publishing",
            "href": "/contributors/publishing"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search BoutiqueDB docs, guides, and architecture..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "claude",
      "chatgpt",
      "perplexity",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:site_name": "BoutiqueDB",
      "twitter:card": "summary_large_image",
      "description": "The local-first database for Swift apps — reactive queries, CloudKit synchronization, and Turso-powered capabilities in a native Swift package.",
      "og:description": "The local-first database for Swift apps — reactive queries, CloudKit synchronization, and Turso-powered capabilities in a native Swift package.",
      "og:image": "https://boutiquedb.mintlify.app/icon.png",
      "og:url": "https://boutiquedb.mintlify.app",
      "og:title": "BoutiqueDB for Swift"
    },
    "organization": {
      "name": "BoutiqueDB",
      "url": "https://github.com/tuliopc23/BoutiqueDB-Swift",
      "logo": "https://boutiquedb.mintlify.app/logo/light.png"
    }
  },
  "metadata": {
    "timestamp": false
  },
  "thumbnails": {
    "appearance": "light",
    "background": "/icon.png",
    "fonts": {
      "family": "Inter"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "errors": {
    "404": {
      "redirect": true,
      "title": "Page not found",
      "description": "That page doesn't exist — head back to the overview."
    }
  }
}
