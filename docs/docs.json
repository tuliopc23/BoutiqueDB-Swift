{
  "$schema": "https://mintlify.com/docs.json",
  "name": "BoutiqueDB",
  "description": "BoutiqueDB is a local-first Swift persistence framework for iOS and macOS, combining SQLite-compatible storage, structured queries, reactive CDC observation, Swift concurrency, and optional CloudKit synchronization.",
  "theme": "luma",
  "colors": {
    "primary": "#E85D3F",
    "light": "#F06A4A",
    "dark": "#FF8A6C"
  },
  "background": {
    "color": {
      "light": "#FBFBF8",
      "dark": "#0B0D10"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "favicon": "/favicon.png",
